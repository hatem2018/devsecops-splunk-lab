apiVersion: enterprise.splunk.com/v4
kind: MonitoringConsole
metadata:
  name: mc
  namespace: {{ splunk_namespace | default("splunk") }}
spec:
  image: docker.io/splunk/splunk:9.3.7
  imagePullPolicy: "IfNotPresent"
  replicas: 1
  licenseAccepted: true
  etcVolumeStorageConfig:
    storageClassName: local-path
    storageCapacity: 30Gi
  licenseManagerRef:
    name: lm

  appRepo:
    appsRepoPollIntervalSeconds: 600
    defaults:
      scope: local
      volumeName: azure-app-volume
    appSources:
      - name: search-app
        location: search-app/

    volumes:
      - name: azure-app-volume
        storageType: blob
        provider: azure
        endpoint: https://<storage-account>.blob.core.windows.net
        path: splunk-apps/
        secretRef: azureblob-secret
  # -------------------------
  # Startup / Probes
  # -------------------------
  readinessInitialDelaySeconds: 300
  readinessTimeoutSeconds: 60
  livenessInitialDelaySeconds: 600
  livenessTimeoutSeconds: 60
  startupProbe:
    failureThreshold: 30
    periodSeconds: 20
    timeoutSeconds: 10